# Normalise line endings for text files; store LF in the repo regardless of OS.
* text=auto

# Explicitly binary — never run text/EOL conversion on these.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.mp4   binary
*.bin   binary
*.woff  binary
*.woff2 binary
*.ico   binary

# .gltf is JSON, so it stays text.
*.gltf  text
